{
  "name": "tree-sitter-swi-prolog",
  "version": "0.1.1",
  "description": "SWI-Prolog grammar for tree-sitter",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Looted/tree-sitter-swi-prolog.git"
  },
  "license": "MIT",
  "author": {
    "name": "Piotr Franczyk"
  },
  "main": "bindings/node/index.js",
  "types": "bindings/node/index.d.ts",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "prolog",
    "swi-prolog"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "kibi-cli": "^2.38.0",
    "kibi-core": "^0.27.0",
    "kibi-mcp": "^3.22.0",
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.7",
    "web-tree-sitter": "^0.27.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "test:corpus": "node scripts/check-corpus.mjs",
    "version-packages": "node scripts/version-packages.mjs",
    "changeset": "changeset"
  }
}
