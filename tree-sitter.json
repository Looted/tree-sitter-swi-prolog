{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "swi_prolog",
      "camelcase": "SwiProlog",
      "title": "SWI-Prolog",
      "scope": "source.prolog",
      "file-types": ["pl", "pro", "prolog", "plt"],
      "injection-regex": "^(prolog|swi[-_]?prolog)$"
    }
  ],
  "metadata": {
    "version": "0.1.1",
    "license": "MIT",
    "description": "SWI-Prolog grammar for tree-sitter",
    "authors": [{ "name": "Piotr Franczyk" }],
    "links": { "repository": "https://github.com/Looted/tree-sitter-swi-prolog" }
  },
  "bindings": { "c": true, "go": true, "node": true, "python": true, "rust": true, "swift": true }
}
